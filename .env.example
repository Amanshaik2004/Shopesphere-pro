# ShopSphere Pro Configuration
PROJECT_NAME="ShopSphere Pro"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Configuration (MySQL)
DATABASE_URL="mysql+pymysql://root:aman2004@localhost:3306/shopsphere_pro_db"
TEST_DATABASE_URL="mysql+pymysql://root:aman2004@localhost:3306/shopsphere_pro_test_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & JWT Authentication
SECRET_KEY="shopsphere_pro_super_secret_jwt_key_for_production_and_testing_change_me_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe Sandbox Payment Gateway
STRIPE_SECRET_KEY="sk_test_shopsphere_mock_sandbox_key"
STRIPE_WEBHOOK_SECRET="whsec_shopsphere_mock_sandbox_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_shopsphere_mock_key"

# Email / SMTP Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="test_smtp_user"
SMTP_PASSWORD="test_smtp_password"
SMTP_FROM_EMAIL="noreply@shopspherepro.com"
SMTP_FROM_NAME="ShopSphere Pro"
SMTP_ENABLED=False

# SMS Provider Configuration
SMS_PROVIDER="sandbox"
SMS_API_KEY="sandbox_sms_api_key"
SMS_SENDER_ID="ShopSphere"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Initial Super Admin Seed
SUPER_ADMIN_EMAIL="superadmin@shopsphere.com"
SUPER_ADMIN_PASSWORD="SuperAdmin123!"
SUPER_ADMIN_FULL_NAME="Super Administrator"
